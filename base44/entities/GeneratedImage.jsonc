{
  "name": "GeneratedImage",
  "type": "object",
  "properties": {
    "prompt": {
      "type": "string",
      "description": "Original user prompt"
    },
    "styled_prompt": {
      "type": "string",
      "description": "Prompt sent to the image provider after applying the selected art style"
    },
    "negative_prompt": {
      "type": "string",
      "description": "Negative style guidance sent when supported by the selected provider"
    },
    "style_id": {
      "type": "string"
    },
    "style_label": {
      "type": "string"
    },
    "owner_user_id": {
      "type": "string"
    },
    "owner_email": {
      "type": "string"
    },
    "owner_name": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "creator_id": {
      "type": "string"
    },
    "creator_email": {
      "type": "string"
    },
    "resolution": {
      "type": "string",
      "default": "1024x1024"
    },
    "aspect_ratio": {
      "type": "string",
      "enum": [
        "1:1",
        "16:9",
        "9:16",
        "4:3",
        "3:4"
      ],
      "default": "1:1"
    },
    "orientation": {
      "type": "string",
      "enum": [
        "square",
        "landscape",
        "portrait"
      ],
      "default": "square"
    },
    "output_size": {
      "type": "string",
      "enum": [
        "standard",
        "large"
      ],
      "default": "standard"
    },
    "quality": {
      "type": "string",
      "enum": [
        "fast",
        "balanced",
        "maximum"
      ],
      "default": "balanced"
    },
    "width": {
      "type": "number",
      "default": 1024
    },
    "height": {
      "type": "number",
      "default": 1024
    },
    "steps": {
      "type": "number",
      "default": 12
    },
    "seed": {
      "type": "number"
    },
    "nsfw": {
      "type": "boolean",
      "default": false
    },
    "provider": {
      "type": "string"
    },
    "space": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "generating",
        "completed",
        "failed"
      ],
      "default": "pending"
    },
    "image_url": {
      "type": "string"
    },
    "source_image_url": {
      "type": "string"
    },
    "thumbnail_url": {
      "type": "string"
    },
    "likes": {
      "type": "number",
      "default": 0
    },
    "error_message": {
      "type": "string"
    },
    "generation_payload_debug": {
      "type": "string"
    }
  },
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "required": [
    "prompt"
  ]
}